# Copy to .env.local for local dev. On Vercel, set these in Project Settings -> Environment Variables.

# Browser-visible (VITE_ prefix = bundled into the client). The Supabase anon key is designed to be public;
# Row Level Security policies in supabase/schema.sql decide what it can do.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Server-only (NO VITE_ prefix = never shipped to the browser). Read only by functions in /api.
LLM_API_KEY=
